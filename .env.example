# Copy to .env and fill in. .env is gitignored; this file is committed and holds
# names only, never values.

# https://console.cloud.google.com — create a project, enable "Books API",
# then Credentials -> API key. Read by api/enrich.ts on the server only; it is
# never sent to the browser. Also set in Vercel for Production and Preview.
GOOGLE_BOOKS_API_KEY=

# https://context7.com/dashboard — used by Claude Code to look up current library
# documentation, not by the site. It is referenced by .mcp.json as
# ${CONTEXT7_API_KEY} and must be present in the environment when Claude Code
# starts, so exporting it in .env alone is not enough:
#
#   PowerShell (this session):  $env:CONTEXT7_API_KEY = "<value>"
#   PowerShell (permanent):     setx CONTEXT7_API_KEY "<value>"   # reopen the terminal
#
# Not needed in Vercel — nothing the deployed site does touches Context7.
CONTEXT7_API_KEY=
